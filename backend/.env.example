# PostgreSQL connection used by Alembic and the authentication API.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/futsal_gear_store
# Generate a secret with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
AUTH_SECRET_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
